# Chancellor — Meta Model API configuration.
# NEVER commit a real key. Copy this file to .env and fill it in locally.
# Base URL from Meta's Model API quickstart.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
# Fill in locally: your key from the Meta Model API console. The value
# below is intentionally empty — this file ships placeholders only.
META_MODEL_API_KEY=
# Optional: per-run cost ceiling in USD enforced by the instruments panel.
CHANCELLOR_MAX_RUN_COST_USD=5.00
# `chancellor demo --live` reads its own pair of names (the offline demo
# needs neither): CHANCELLOR_META_API_BASE (same URL as above) and
# CHANCELLOR_META_API_KEY (your key, filled in locally, never committed).
